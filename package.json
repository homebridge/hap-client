{
  "name": "@homebridge/hap-client",
  "version": "1.10.0",
  "description": "A client for HAP-NodeJS.",
  "main": "./dist/index.js",
  "scripts": {
    "check": "npm install && npm outdated",
    "lint": "eslint src/**.ts",
    "build": "tsc",
    "gen": "ts-node -P tsconfig.gen.json scripts/gen-hap-types.ts",
    "prepublishOnly": "npm run lint && npm run build",
    "clean": "rimraf ./dist",
    "test": "eslint src/**.ts"
  },
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/homebridge/hap-client.git"
  },
  "keywords": [
    "hap",
    "homebridge",
    "api"
  ],
  "author": {
    "name": "oznu",
    "email": "dev@oz.nu"
  },
  "contributors": [
    {
      "name": "homebridge",
      "url": "https://github.com/homebridge"
    }
  ],
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/homebridge/hap-client/issues/"
  },
  "homepage": "https://github.com/homebridge/hap-client/blob/latest#readme",
  "dependencies": {
    "axios": "^1.6.8",
    "bonjour-service": "^1.2.1",
    "decamelize": "^6.0.0",
    "inflection": "^3.0.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^20.12.2",
    "@types/source-map-support": "^0.5.10",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^27.9.0",
    "hap-nodejs": "^0.11.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  }
}
