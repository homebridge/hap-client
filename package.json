{
  "name": "@homebridge/hap-client",
  "type": "module",
  "version": "5.4.0",
  "description": "A client for HAP-NodeJS.",
  "author": {
    "name": "Homebridge"
  },
  "contributors": [
    {
      "name": "homebridge",
      "url": "https://github.com/homebridge"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/homebridge/hap-client/blob/latest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homebridge/hap-client.git"
  },
  "bugs": {
    "url": "https://github.com/homebridge/hap-client/issues/"
  },
  "keywords": [
    "hap",
    "homebridge",
    "api"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hap-types": {
      "types": "./dist/hap-types.d.ts",
      "default": "./dist/hap-types.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "scripts": {
    "check": "npm install && npm outdated",
    "clean": "rimraf ./dist",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "build": "tsc",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage",
    "gen": "tsx scripts/gen-hap-types.ts",
    "exampleWatch": "nodemon --config nodemon.json"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "decamelize": "^7.0.0",
    "inflection": "^3.0.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@homebridge/hap-nodejs": "^2.2.4-beta.7",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint-plugin-format": "^2.0.1",
    "homebridge-lib": "^8.1.5",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "^0.19.1"
    },
    "oxfmt": {
      "tinypool": "^2.2.0"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
