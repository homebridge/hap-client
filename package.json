{
  "name": "@homebridge/hap-client",
  "type": "module",
  "version": "5.1.0",
  "description": "A client for HAP-NodeJS.",
  "author": {
    "name": "Homebridge"
  },
  "contributors": [
    {
      "name": "homebridge",
      "url": "https://github.com/homebridge"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/homebridge/hap-client/blob/latest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homebridge/hap-client.git"
  },
  "bugs": {
    "url": "https://github.com/homebridge/hap-client/issues/"
  },
  "keywords": [
    "hap",
    "homebridge",
    "api"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hap-types": {
      "types": "./dist/hap-types.d.ts",
      "default": "./dist/hap-types.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "check": "npm install && npm outdated",
    "clean": "rimraf ./dist",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "build": "tsc",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage",
    "gen": "ts-node --esm scripts/gen-hap-types.ts"
  },
  "dependencies": {
    "axios": "1.18.1",
    "bonjour-service": "1.4.3",
    "decamelize": "6.0.1",
    "inflection": "3.0.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@homebridge/hap-nodejs": "^2.1.9",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint-plugin-format": "^2.0.1",
    "homebridge-lib": "^8.1.3",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
