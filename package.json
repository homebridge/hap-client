{
  "name": "@homebridge/hap-client",
  "type": "module",
  "version": "2.0.4",
  "description": "A client for HAP-NodeJS.",
  "author": {
    "name": "oznu",
    "email": "dev@oz.nu"
  },
  "contributors": [
    {
      "name": "homebridge",
      "url": "https://github.com/homebridge"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/homebridge/hap-client/blob/latest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homebridge/hap-client.git"
  },
  "bugs": {
    "url": "https://github.com/homebridge/hap-client/issues/"
  },
  "keywords": [
    "hap",
    "homebridge",
    "api"
  ],
  "exports": "./dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": "^18 || ^20 || ^22"
  },
  "scripts": {
    "build": "tsc",
    "check": "npm install && npm outdated",
    "clean": "rimraf dist && rimraf coverage",
    "gen": "node --no-warnings=ExperimentalWarning --loader ts-node/esm scripts/gen-hap-types.ts",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "echo \"Error: no test specified\" && exit 0"
  },
  "dependencies": {
    "axios": "1.7.7",
    "bonjour-service": "^1.3.0",
    "decamelize": "^6.0.0",
    "inflection": "3.0.0",
    "source-map-support": "0.5.21"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.9.2",
    "@types/node": "^22.9.1",
    "@types/source-map-support": "^0.5.10",
    "eslint": "^9.15.0",
    "eslint-plugin-format": "^0.1.2",
    "hap-nodejs": "^1.1.1-alpha.21",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
